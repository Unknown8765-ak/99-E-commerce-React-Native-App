{
  "expo": {
    "name": "99",
    "slug": "99",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "app99",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/logo.png"
    },

    "android": {
      "package": "com.yourname.ninetynine",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 500
        }
      ],
      "expo-secure-store",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyCOrRt20WF58PB28iOZPAtEMZ9YKThKHyk"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "19f3ef73-8efd-49fd-9e0b-4ecfcca8e758"
      }
    }
  }
}